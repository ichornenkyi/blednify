+package expo.modules.audio.service
+
+import android.os.Looper
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.MediaItem
+import androidx.media3.common.Player
+import androidx.media3.common.SimpleBasePlayer
+import androidx.media3.common.util.UnstableApi
+import com.google.common.util.concurrent.Futures
+import com.google.common.util.concurrent.ListenableFuture
+
+/**
+ * Blednify patch: the session's player while nothing is loaded. Android Auto needs a session to connect
+ * to and browse even before the app played anything; pressing play asks JS to resume the saved queue.
+ */
+@UnstableApi
+internal class IdleSessionPlayer(
+  looper: Looper,
+  private val onPlay: () -> Unit
+) : SimpleBasePlayer(looper) {
+  private val commands = Player.Commands.Builder()
+    .addAll(
+      Player.COMMAND_PLAY_PAUSE,
+      Player.COMMAND_PREPARE,
+      Player.COMMAND_STOP,
+      Player.COMMAND_SET_MEDIA_ITEM,
+      Player.COMMAND_CHANGE_MEDIA_ITEMS,
+      Player.COMMAND_GET_CURRENT_MEDIA_ITEM,
+      Player.COMMAND_GET_TIMELINE,
+      Player.COMMAND_GET_METADATA
+    )
+    .build()
+
+  override fun getState(): State = State.Builder()
+    .setAvailableCommands(commands)
+    .setPlaybackState(Player.STATE_IDLE)
+    .setPlayWhenReady(false, Player.PLAY_WHEN_READY_CHANGE_REASON_USER_REQUEST)
+    .build()
+
+  override fun handleSetPlayWhenReady(playWhenReady: Boolean): ListenableFuture<*> {
+    if (playWhenReady) onPlay()
+    return Futures.immediateVoidFuture()
+  }
+
+  override fun handlePrepare(): ListenableFuture<*> = Futures.immediateVoidFuture()
+
+  override fun handleStop(): ListenableFuture<*> = Futures.immediateVoidFuture()
+
+  override fun handleSetMediaItems(
+    mediaItems: MutableList<MediaItem>,
+    startIndex: Int,
+    startPositionMs: Long
+  ): ListenableFuture<*> = Futures.immediateVoidFuture()
+}
+
+/**
+ * Blednify patch: JS owns the queue. Items a controller (Android Auto) asks to play are routed to JS by
+ * the session callback, so the session must not load them into the native player itself, and the
+ * controller's follow-up play() must not resume the old track while JS builds the new queue.
+ */
+@UnstableApi
+internal class AutoRoutingPlayer(player: Player) : ForwardingPlayer(player) {
+  override fun setMediaItem(mediaItem: MediaItem) = Unit
+  override fun setMediaItem(mediaItem: MediaItem, startPositionMs: Long) = Unit
+  override fun setMediaItem(mediaItem: MediaItem, resetPosition: Boolean) = Unit
+  override fun setMediaItems(mediaItems: MutableList<MediaItem>) = Unit
+  override fun setMediaItems(mediaItems: MutableList<MediaItem>, resetPosition: Boolean) = Unit
+  override fun setMediaItems(mediaItems: MutableList<MediaItem>, startIndex: Int, startPositionMs: Long) = Unit
+  override fun addMediaItem(mediaItem: MediaItem) = Unit
+  override fun addMediaItem(index: Int, mediaItem: MediaItem) = Unit
+  override fun addMediaItems(mediaItems: MutableList<MediaItem>) = Unit
+  override fun addMediaItems(index: Int, mediaItems: MutableList<MediaItem>) = Unit
+  override fun replaceMediaItem(index: Int, mediaItem: MediaItem) = Unit
+  override fun replaceMediaItems(fromIndex: Int, toIndex: Int, mediaItems: MutableList<MediaItem>) = Unit
+
+  override fun play() {
+    if (!AutoLibrary.isPlayRequestPending()) super.play()
+  }
+
+  override fun setPlayWhenReady(playWhenReady: Boolean) {
+    if (playWhenReady && AutoLibrary.isPlayRequestPending()) return
+    super.setPlayWhenReady(playWhenReady)
+  }
+}
