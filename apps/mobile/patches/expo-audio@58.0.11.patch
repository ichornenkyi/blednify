+@OptIn(UnstableApi::class)
+object AutoLibrary {
+  const val ROOT_ID = "__blednify_root__"
+  private const val TAG = "BlednifyAuto"
+  private const val FILE_NAME = "blednify-auto-library.json"
+
+  /** After a play request, ignore `play()` from the controller until JS has loaded the new queue. */
+  private const val PLAY_REQUEST_GRACE_MS = 4_000L
+
+  private data class Node(
+    val id: String,
+    val title: String,
+    val subtitle: String?,
+    val playable: Boolean,
+    val children: List<String>?
+  )
+
+  private val mainHandler = Handler(Looper.getMainLooper())
+
+  @Volatile private var nodes: Map<String, Node> = mapOf(ROOT_ID to emptyRoot())
+  @Volatile private var loaded = false
+  private var sessionRef: WeakReference<MediaLibrarySession>? = null
+
+  private val pending = ArrayList<Map<String, String>>()
+  private var emitter: ((Map<String, String>) -> Unit)? = null
+  private var reactStartRequested = false
+
+  @Volatile private var playRequestedAt = 0L
+
+  private fun emptyRoot() = Node(ROOT_ID, "Blednify", null, false, emptyList())
+
+  // --- Tree ------------------------------------------------------------------------------------
+
+  fun setTree(context: Context, json: String) {
+    val parsed = try {
+      parse(json)
+    } catch (e: Exception) {
+      Log.w(TAG, "Invalid Android Auto library", e)
+      return
+    }
+    nodes = parsed
+    loaded = true
+    try {
+      File(context.filesDir, FILE_NAME).writeText(json)
+    } catch (e: Exception) {
+      Log.w(TAG, "Could not persist Android Auto library", e)
+    }
+    notifyChanged()
+  }
+
+  fun ensureLoaded(context: Context) {
+    if (loaded) return
+    loaded = true
+    try {
+      val file = File(context.filesDir, FILE_NAME)
+      if (file.exists()) nodes = parse(file.readText())
+    } catch (e: Exception) {
+      Log.w(TAG, "Could not read Android Auto library", e)
+    }
+  }
+
+  /** JSON: an array of top-level nodes `{ id, title, sub?, play?, kids? }`; `kids` makes a node browsable. */
+  private fun parse(json: String): Map<String, Node> {
+    val out = HashMap<String, Node>()
+    fun walk(arr: JSONArray): List<String> {
+      val ids = ArrayList<String>(arr.length())
+      for (i in 0 until arr.length()) {
+        val o: JSONObject = arr.getJSONObject(i)
+        val id = o.getString("id")
+        val kids = o.optJSONArray("kids")?.let { walk(it) }
+        out[id] = Node(
+          id = id,
+          title = o.optString("title"),
+          subtitle = if (o.has("sub")) o.optString("sub") else null,
+          playable = o.optBoolean("play", kids == null),
+          children = kids
+        )
+        ids.add(id)
+      }
+      return ids
+    }
+    val roots = walk(JSONArray(json))
+    out[ROOT_ID] = Node(ROOT_ID, "Blednify", null, false, roots)
+    return out
+  }
+
+  fun attachSession(session: MediaLibrarySession?) {
+    sessionRef = session?.let { WeakReference(it) }
+  }
+
+  private fun notifyChanged() {
+    mainHandler.post {
+      val session = sessionRef?.get() ?: return@post
+      val snapshot = nodes
+      for (node in snapshot.values) {
+        val kids = node.children ?: continue
+        try {
+          session.notifyChildrenChanged(node.id, kids.size, null)
+        } catch (e: Exception) {
+          Log.w(TAG, "notifyChildrenChanged failed", e)
+        }
+      }
+    }
+  }
+
+  private fun toItem(node: Node): MediaItem {
+    val browsable = node.children != null
+    val metadata = MediaMetadata.Builder()
+      .setTitle(node.title)
+      .setDisplayTitle(node.title)
+      .setIsBrowsable(browsable)
+      .setIsPlayable(node.playable)
+      .setMediaType(
+        when {
+          node.id == ROOT_ID -> MediaMetadata.MEDIA_TYPE_FOLDER_MIXED
+          browsable -> MediaMetadata.MEDIA_TYPE_PLAYLIST
+          else -> MediaMetadata.MEDIA_TYPE_MUSIC
+        }
+      )
+      .apply {
+        node.subtitle?.let {
+          setSubtitle(it)
+          if (!browsable) setArtist(it)
+        }
+      }
+      .build()
+    return MediaItem.Builder().setMediaId(node.id).setMediaMetadata(metadata).build()
+  }
+
+  fun rootItem(): MediaItem = toItem(nodes[ROOT_ID] ?: emptyRoot())
+
+  fun item(id: String): MediaItem? = nodes[id]?.let(::toItem)
+
+  fun isPlayable(id: String): Boolean = nodes[id]?.playable == true
+
+  fun children(parentId: String, page: Int, pageSize: Int): List<MediaItem>? {
+    val snapshot = nodes
+    val ids = snapshot[parentId]?.children ?: return null
+    val from = (page.toLong() * pageSize).coerceAtMost(ids.size.toLong()).toInt()
+    val to = (from.toLong() + pageSize).coerceAtMost(ids.size.toLong()).toInt()
+    return ids.subList(from, to).mapNotNull { snapshot[it]?.let(::toItem) }
+  }
+
+  /** Root hints: list rows (not grids) for both folders and tracks. */
+  fun rootExtras(): Bundle = Bundle().apply {
+    putInt("android.media.browse.CONTENT_STYLE_BROWSABLE_HINT", 1)
+    putInt("android.media.browse.CONTENT_STYLE_PLAYABLE_HINT", 1)
+  }
+
+  // --- Requests to JS --------------------------------------------------------------------------
+
+  fun isPlayRequestPending(): Boolean =
+    System.currentTimeMillis() - playRequestedAt < PLAY_REQUEST_GRACE_MS
+
+  /** JS loaded something (the lock-screen player changed); controller play() calls are real again. */
+  fun clearPlayRequest() {
+    playRequestedAt = 0L
+  }
+
+  fun request(context: Context, type: String, value: String = "") {
+    if (type != "resume") playRequestedAt = System.currentTimeMillis()
+    val event = mapOf("type" to type, "value" to value)
+    mainHandler.post {
+      val emit = emitter
+      if (emit != null) {
+        emit(event)
+        return@post
+      }
+      synchronized(pending) { pending.add(event) }
+      startReact(context)
+    }
+  }
+
+  /** Called on the main thread by the audio module when JS starts / stops listening. */
+  fun attachEmitter(emit: ((Map<String, String>) -> Unit)?) {
+    mainHandler.post {
+      emitter = emit
+      if (emit == null) return@post
+      reactStartRequested = false
+      drain().forEach(emit)
+    }
+  }
+
+  fun drain(): List<Map<String, String>> {
+    synchronized(pending) {
+      val queued = ArrayList(pending)
+      pending.clear()
+      return queued
+    }
+  }
+
+  private fun startReact(context: Context) {
+    if (reactStartRequested) return
+    reactStartRequested = true
+    // ReactApplication.getReactHost().start() through reflection: expo-audio does not compile against react-android.
+    try {
+      val app = context.applicationContext
+      val host = app.javaClass.getMethod("getReactHost").invoke(app) ?: return
+      host.javaClass.getMethod("start").invoke(host)
+    } catch (e: Exception) {
+      Log.w(TAG, "Could not start React for an Android Auto request", e)
+    }
+  }
+}
