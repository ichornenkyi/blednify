# Copy to .env (git-ignored) and fill in. Never commit real values.

# Required: every library read needs it, and the server refuses to start without it. Generate one with:
# openssl rand -base64 32
LISTEN_TOKEN=
# Only on a trusted LAN: serve the library without a listen token.
# ALLOW_OPEN_READS=1

# Required for uploads, deletes and rescans. Generate a different one: openssl rand -base64 32
ADMIN_TOKEN=

# Missing lyrics are looked up on lrclib.net. Set to 0 to keep the server fully offline.
LYRICS_ONLINE=1

# Optional: a Spotify developer app (https://developer.spotify.com/dashboard, client credentials). Without it,
# Spotify imports read the public playlist page, which lists at most 100 songs and no album names.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Docker → copy the token after `--token`.
CLOUDFLARE_TUNNEL_TOKEN=

# Starts the tunnel service with `docker compose up -d`. Remove this line for LAN-only use.
COMPOSE_PROFILES=tunnel
